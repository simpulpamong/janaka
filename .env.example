# ===== FIREBASE (klien / browser) =====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ===== FIREBASE ADMIN SDK (server saja — JANGAN awali dengan VITE_) =====
# Diperlukan untuk: Manajemen Pengguna (buat/ubah/hapus akun), Penetapan
# izin per menu, atur ulang password, dan profile sebagai sumber kebenaran.
#
# Cara memperolehnya:
#   Firebase Console → Project Settings → Service Accounts → Generate new
#   private key → unduh JSON → tempelkan seluruh isi JSON (satu baris)
#   ke FIREBASE_SERVICE_ACCOUNT di bawah.
#
# ⚠️ Jangan pernah memakai prefix VITE_ untuk nilai ini — yang berawalan
#    VITE_ ikut ter-render ke dalam bundle browser.
FIREBASE_SERVICE_ACCOUNT=

# Alternatif: simpan JSON di berkas lalu arahkan ke lokasinya.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Seed administrator pertama (dipakai `npm run seed:admin`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAMA=Administrator JANAKA
ADMIN_JABATAN=Administrator Sistem

# ===== CLOUDINARY =====
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_API_SECRET=

# ===== PTSP API (Sprinter Ponorogo) =====
VITE_PTSP_BASE_URL=https://sprinter.ponorogo.go.id
PTSP_API_KEY=

# ===== SERVER PRODUKSI =====
PORT=5173