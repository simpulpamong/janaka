{
  "name": "janaka",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "JANAKA — Jaringan Navigasi Penegakan Perda · Sistem Penegakan Perda & Pengawasan Perizinan Reklame Satpol PP Kabupaten Ponorogo",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx --env-file=.env server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:node && npm run typecheck:tools",
    "test:deadcode": "tsx tools/cek-deadcode.mts",
    "test:tools": "tsx tools/cek-tools.mts",
    "test:kontrak": "tsx tools/cek-kontrak.mts",
    "test:tata-letak": "tsx tools/cek-tata-letak.mts",
    "test:jsx": "tsx tools/cek-jsx.mts",
    "test:zindex": "tsx tools/cek-zindex.mts",
    "test:profil": "tsx tools/cek-profil.mts",
    "test:aman": "tsx tools/cek-aman.mts",
    "test:aset": "tsx tools/cek-aset.mts",
    "test:koneksi": "tsx tools/cek-koneksi.mts",
    "cek:vercel": "tsx tools/cek-vercel.mts",
    "test:kuota": "tsx tools/cek-kuota.mts",
    "test:dasar": "npm run typecheck:all && npm run test:deadcode && npm run test:tools && npm run test:kontrak && npm run test:tata-letak && npm run test:jsx && npm run test:zindex && npm run test:profil && npm run test:aman && npm run test:aset",
    "test:e2e": "tsx --env-file=.env tools/legacy/cek-integration-test.mts",
    "test:quality": "tsx --env-file=.env tools/legacy/cek-quality-test.mts",
    "test:api": "tsx --env-file=.env tools/legacy/cek-api-security-test.mts",
    "test": "npm run test:dasar && npm run test:e2e && npm run test:quality && npm run test:api",
    "verify": "npm run typecheck:all && tsc -b --force && vite build && npm run test:deadcode && npm run test:tools && npm run test:kontrak && npm run test:tata-letak && npm run test:jsx && npm run test:zindex && npm run test:profil && npm run test:aman && npm run test:aset",
    "seed:admin": "tsx --env-file=.env tools/legacy/seed-admin.mts",
    "gen:sitemap": "tsx scripts/gen-sitemap.mts",
    "gen:icons": "tsx tools/legacy/gen-icons.mts",
    "postbuild": "npm run gen:sitemap"
  },
  "dependencies": {
    "@types/leaflet.pm": "^0.13.9",
    "axios": "^1.7.9",
    "date-fns": "^3.6.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.10.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "leaflet": "^1.9.4",
    "leaflet.pm": "^2.2.0",
    "lucide-react": "^0.451.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
